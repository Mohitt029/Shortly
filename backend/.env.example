# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=5000
API_VERSION=v1
BASE_URL=http://localhost:5000
SHORT_URL_DOMAIN=http://localhost:5000

# ============================================
# MONGODB ATLAS
# Get your connection string from:
# https://cloud.mongodb.com → Your Project → Database → Connect → Drivers
# ============================================
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/shortly?retryWrites=true&w=majority&appName=Cluster0

# ============================================
# REDIS / MEMURAI (Local Windows Redis)
# Memurai runs on 127.0.0.1:6379 by default
# ============================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6379

# ============================================
# JWT AUTHENTICATION
# Generate secure secrets with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ============================================
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_change_me
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars_change_me
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# URL SHORTENING
# ============================================
SHORT_CODE_LENGTH=7
MAX_CUSTOM_ALIAS_LENGTH=16
DEFAULT_URL_EXPIRY_DAYS=365
BASE62_ALPHABET=0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ

# ============================================
# SNOWFLAKE ID CONFIG
# Epoch = Jan 1, 2024 (1704067200000 ms)
# Worker/Datacenter IDs must be unique per instance
# ============================================
SNOWFLAKE_EPOCH=1704067200000
SNOWFLAKE_WORKER_ID=1
SNOWFLAKE_DATACENTER_ID=1

# ============================================
# CACHE CONFIGURATION (TTL in seconds)
# ============================================
CACHE_DEFAULT_TTL=86400
CACHE_MAX_TTL=604800

# ============================================
# RATE LIMITING
# Window in ms (900000 = 15 min), max requests per window
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING
# Levels: error | warn | info | http | debug
# ============================================
LOG_LEVEL=info
LOG_DIR=logs

# ============================================
# CORS (comma-separated origins)
# ============================================
CORS_ORIGIN=http://localhost:5173,http://localhost:3000