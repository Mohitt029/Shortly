{
  "name": "shortly-backend",
  "version": "1.0.0",
  "description": "Production-grade URL shortener backend - MERN Stack",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
  "start": "node --require ./dns-config.js src/server.js",
  "dev": "nodemon --require ./dns-config.js src/server.js",
  "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles",
  "test:unit": "cross-env NODE_ENV=test jest tests/unit",
  "test:integration": "cross-env NODE_ENV=test jest tests/integration"
},
  "keywords": [
    "url-shortener",
    "system-design",
    "mern",
    "mongodb",
    "redis"
  ],
  "author": "Mohitt",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "geoip-lite": "^2.0.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "morgan": "^1.12.1",
    "nanoid": "^6.0.1",
    "node-cron": "^4.6.0",
    "qrcode": "^1.5.4",
    "redis": "^6.2.1",
    "useragent": "^2.3.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}